{
  "name": "manifest-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Manifest — last-mile delivery dispatch for dispensaries. Demo uses fictional data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rpc": "node scripts/test-rpcs.mjs",
    "bench:broadcast": "node scripts/bench-broadcast.mjs --tiers 10,25,50 --seconds 25",
    "bench:sim": "python scripts/bench-sim.py --seconds 20 --port 5226",
    "bench:bundle": "node scripts/bench-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/source-serif-4": "^5.3.0",
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "@supabase/supabase-js": "^2.111.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
